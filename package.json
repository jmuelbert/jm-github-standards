{
	"name": "jm-github-standards",
	"version": "1.0.0",
	"description": "jm github standards",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"docs:build": "pnpm --filter ./docs build",
		"docs:dev": "pnpm --filter ./docs dev",
		"docs:preview": "pnpm --filter ./docs preview",
		"docs:astro": "pnpm --filter ./docs astro",
		"docs:clean": "pnpm --filter ./docs clean",
		"docs:update": "pnpm --filter ./docs update",
		"docs:cspell": "cspell --no-progress",
		"docs:cspell:docs": "cspell --no-progress docs/**",
		"docs:cspell:project-words": "echo '# New Words' >> project-words.txt && cspell --words-only --unique | sort --ignore-case >> project-words.txt",
		"docs:cspell:suggests": "cspell --no-progress --show-suggestions --show-context",
		"docs:full-check": "pnpm docs:clean && pnpm docs:cspell:docs",
		"docs:lint:biome": "pnpm biome check docs/",
		"docs:lint": "pnpm docs:lint:biome && pnpm lint:markdown && pnpm docs:cspell",
		"lint:biome": "biome check .",
		"fix:biome": "biome check . --fix",
		"format:biome": "biome format --write",
		"lint:markdown": "rumdl check .",
		"lint:reuse": "echo 'REUSE-Compliance is requested via GitHub Action (Heavy-Check).'",
		"lint:toml": "tombi lint",
		"format:toml": "tombi format",
		"fix:markdown": "rumdl check --fix .",
		"lint:typecheck": "pnpm --recursive run typecheck",
		"lint:yaml": "echo 'YAML-Check is requested via GitHub Action (Heavy-Check).'",
		"lint": "pnpm lint:biome && pnpm lint:typecheck &&  pnpm lint:toml && pnpm lint:markdown",
		"format": "pnpm fix:markdown && pnpm format:biome && pnpm format:toml",
		"changelog": "git-cliff --output CHANGELOG.md",
		"changelog:check": "git-cliff --output CHANGELOG.md --unreleased",
		"changelog:version": "git-cliff --tag $npm_config_version --output CHANGELOG.md"
	},
	"keywords": [
		"develop",
		"dev tools",
		"spellcheck"
	],
	"author": "Jürgen Mülbert",
	"license": "EUPL-1.2",
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@commitlint/config-conventional": "^21.2.4",
		"@cspell/dict-de-de": "^4.1.3",
		"@cspell/dict-es-es": "^3.0.9",
		"@cspell/dict-it-it": "^3.1.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"commitlint": "^21.2.4",
		"cspell": "^10.4.0",
		"gh-pages": "^6.3.0",
		"git-cliff": "^2.14.2",
		"globals": "^17.14.0",
		"lefthook": "^2.2.2",
		"rumdl": "^0.3.2",
		"tombi": "^1.10.0",
		"typescript": "~6.0.3"
	},
	"browserslist": {
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=22.23.4"
	}
}
