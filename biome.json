{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
    	"**",
     "!**/*.generated.js",
     "!!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "lineWidth": 120
    },
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
      {
        "includes": ["**/*.astro"],
        "linter": {
          "rules": {
            "correctness": {
              "noUnusedImports": "off",
              "noUnusedVariables": "off"
            }
          }
        }
      }
    ]
}
